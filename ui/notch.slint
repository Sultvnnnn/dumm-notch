export component MainWindow inherits Window {
    title: "DummNotchOverlay";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    width: 420px;
    height: 160px;

    in-out property <bool> is_expanded: false;
    // Diisi layanan media; string kosong berarti tidak ada sesi.
    in property <string> media-title;
    in property <string> media-artist;
    in property <bool> is-playing;
    in property <image> media-artwork;
    // Timeline dari GSMTC, diambil saat event (bukan timer).
    in property <float> position-frac: 0.0;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> volume-level: 0.0;
    in property <bool> volume-muted: false;
    // V2: false sampai main.rs menyelesaikan pembaruan volume pertama (baseline). Selama
    // false, perubahan volume-level tidak memunculkan HUD sehingga tidak berkedip saat start.
    in property <bool> volume-ready: false;
    in-out property <bool> hud-visible: false;
    callback play-pause();
    callback next();
    callback previous();

    // Satu timer sekali-jalan untuk HUD volume. Saat idle `running == false` (tidak ada timer
    // hidup). Trigger mematikan HUD; karena `running` terikat `hud-visible`, timer ikut mati.
    hud-timer := Timer {
        interval: 1500ms;
        running: root.hud-visible;
        triggered => { root.hud-visible = false; }
    }

    changed volume-level => {
        if (root.volume-ready) { root.hud-visible = true; hud-timer.restart(); }
    }
    changed volume-muted => {
        if (root.volume-ready) { root.hud-visible = true; hud-timer.restart(); }
    }

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;

        width: is_expanded ? 380px : 180px;
        height: is_expanded ? 90px : 32px;
        background: #09090b;
        border-bottom-left-radius: 18px;
        border-bottom-right-radius: 18px;

        animate width { duration: 250ms; easing: ease-out; }
        animate height { duration: 250ms; easing: ease-out; }

        // Satu TouchArea untuk seluruh pill. TouchArea yang bersarang di dalam layout tidak
        // menerima hit-test (terbukti dari pengujian klik: badan pill selalu menang), jadi
        // tombol ditentukan dari posisi pointer di dalam area ini.
        TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                root.is_expanded = self.has-hover;
            }

            clicked => {
                if (root.is_expanded) {
                    // Baris tombol berada 4-26 px dari tepi bawah pill, dengan pusat
                    // di width/2 - 26, width/2, width/2 + 26 (spacing 8 px + ikon 18 px).
                    if (self.mouse-y >= self.height - 26px && self.mouse-y <= self.height - 4px) {
                        if (self.mouse-x < self.width / 2 - 13px) {
                            root.previous();
                        } else if (self.mouse-x > self.width / 2 + 13px) {
                            root.next();
                        } else {
                            root.play-pause();
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 6px;
            spacing: 1px;
            alignment: center;

            if !root.is_expanded: Text {
                text: "Dumm";
                color: #f4f4f5;
                font-size: 12px;
                overflow: elide;
                horizontal-alignment: center;
            }

            // Baris 1: artwork di kiri, judul + artis rata kiri di kanannya.
            if root.is_expanded: HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 8px;
                    background: #18181b;
                    clip: true;
                    Image { source: root.media-artwork; image-fit: cover; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.media-title != "" ? root.media-title : "Dumm Active";
                        color: #f4f4f5;
                        font-size: 13px;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                    Text {
                        text: root.media-artist != "" ? root.media-artist : "Media & HUD Hub";
                        color: #a1a1aa;
                        font-size: 11px;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                }
            }

            // Baris 2: progress bar tipis.
            if root.is_expanded: Rectangle {
                height: 3px;
                border-radius: 2px;
                background: #27272a;
                Rectangle {
                    width: parent.width * Math.max(0.0, Math.min(1.0, root.position-frac));
                    height: parent.height;
                    border-radius: 2px;
                    background: #f4f4f5;
                }
            }

            // Baris 3: waktu berjalan (kiri) dan durasi (kanan). Tersembunyi bila timeline kosong.
            if root.is_expanded && root.duration-label != "": Rectangle {
                height: 10px;
                Text {
                    x: 0px;
                    text: root.position-label;
                    color: #a1a1aa;
                    font-size: 9px;
                    horizontal-alignment: left;
                }
                Text {
                    x: parent.width - 44px;
                    width: 44px;
                    text: root.duration-label;
                    color: #a1a1aa;
                    font-size: 9px;
                    horizontal-alignment: right;
                }
            }

            // Baris 4: kontrol transport, di tengah.
            if root.is_expanded: HorizontalLayout {
                alignment: center;
                spacing: 8px;

                // Ikon Phosphor (MIT), bobot fill. Ikon hanya tampilan; yang menangkap klik
                // adalah TouchArea di atas.
                Image {
                    width: 18px; height: 18px;
                    source: @image-url("../assets/icons/skip-back.svg");
                }
                Image {
                    width: 18px; height: 18px;
                    source: root.is-playing
                        ? @image-url("../assets/icons/pause.svg")
                        : @image-url("../assets/icons/play.svg");
                }
                Image {
                    width: 18px; height: 18px;
                    source: @image-url("../assets/icons/skip-forward.svg");
                }
            }
        }
    }

    // HUD volume: bar 4 px di bagian bawah pill + angka persen (10 px) di kanan. Anak root
    // (bukan pill) agar bebas diposisikan; koordinat mengikuti geometri pill sehingga tidak
    // mengubah tinggi pill dan tidak menggeser baris ikon. Muncul saat expanded maupun collapsed.
    if root.hud-visible: Rectangle {
        // V3: margin horizontal 12 px (radius 18 px) agar bar tidak menyentuh tepi
        // membulat pill sehingga ujung bawah tidak tampak persegi.
        x: pill.x + 12px;
        y: pill.y + pill.height - 6px;
        width: pill.width - 24px;
        height: 4px;
        border-radius: 2px;
        background: #27272a;
        Rectangle {
            width: root.volume-muted
                ? parent.width
                : parent.width * Math.max(0.0, Math.min(1.0, root.volume-level));
            height: parent.height;
            border-radius: 2px;
            background: root.volume-muted ? #71717a : #f4f4f5;
        }
    }
    if root.hud-visible: Text {
        x: pill.x + pill.width - 50px;
        y: pill.y + pill.height - 16px;
        width: 44px;
        height: 12px;
        text: root.volume-muted ? "Muted" : "\{Math.round(root.volume-level * 100)}%";
        color: #f4f4f5;
        font-size: 10px;
        horizontal-alignment: right;
    }
}
