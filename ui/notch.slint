export component MainWindow inherits Window {
    title: "DummNotchOverlay";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    // Skala antarmuka. Diisi main.rs dari ukuran layar (1920 -> 1.3, 2560 -> 1.6, dst).
    in property <float> scale: 1.0;

    width: 420px * root.scale;
    height: 146px * root.scale;

    in-out property <bool> is_expanded: false;
    in property <string> media-title;
    in property <string> media-artist;
    in property <bool> is-playing;
    in property <image> media-artwork;
    in property <float> position-frac: 0.0;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> volume-level: 0.0;
    in property <bool> volume-muted: false;
    in property <bool> volume-ready: false;
    in-out property <bool> hud-visible: false;
    // 0 = tidak ada, 1 = previous, 2 = play/pause, 3 = next.
    out property <int> hover-zone;
    // Posisi kursor dilaporkan TouchArea ke root karena elemen di dalam `pill` tidak terlihat
    // dari binding level root.
    in-out property <length> pointer-x: 0px;
    in-out property <bool> pointer-in: false;

    callback play-pause();
    callback next();
    callback previous();

    hud-timer := Timer {
        interval: 1500ms;
        running: root.hud-visible;
        triggered => { root.hud-visible = false; }
    }

    changed volume-level => {
        if (root.volume-ready) { root.hud-visible = true; hud-timer.restart(); }
    }
    changed volume-muted => {
        if (root.volume-ready) { root.hud-visible = true; hud-timer.restart(); }
    }

    // Geometri kontrol, dipakai bersama oleh ikon dan zona klik supaya keduanya tidak pernah
    // meleset. Jarak antar-pusat = ukuran tombol + spacing.
    private property <length> button-size: 34px * root.scale;
    private property <length> button-gap: 20px * root.scale;
    private property <length> center-offset: 54px * root.scale;

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;

        width: is_expanded ? 380px * root.scale : 180px * root.scale;
        height: is_expanded ? 122px * root.scale : 34px * root.scale;
        background: #0a0a0c;
        border-width: 1px;
        border-color: #1c1c20;
        border-bottom-left-radius: 18px * root.scale;
        border-bottom-right-radius: 18px * root.scale;

        // Konten tidak boleh tumpah keluar pill selama animasi: tanpa clip, baris ikon sudah
        // tampil pada ukuran penuh sementara kartu masih membesar (terlihat "terpisah").
        clip: true;

        animate width { duration: 200ms; easing: ease-in-out; }
        animate height { duration: 200ms; easing: ease-in-out; }

        ta := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                root.pointer-in = self.has-hover;
                root.is_expanded = self.has-hover;
            }
            changed mouse-x => {
                root.pointer-x = self.mouse-x;
            }

            // Zona klik = tombol terdekat. Klik di mana saja pada kartu tetap bekerja, dan
            // mengklik ikon selalu memicu ikon itu (bukan zona sepertiga yang tidak sejajar).
            clicked => {
                if (root.is_expanded) {
                    root.dispatch(root.zone(self.mouse-x, self.width, root.center-offset));
                }
            }
        }

        // Konten ikut memudar masuk setelah kartu membesar, jadi satu gerakan yang utuh.
        open-content := VerticalLayout {
            padding: 12px * root.scale;
            spacing: 6px * root.scale;
            alignment: center;
            opacity: is_expanded ? 1.0 : 0.0;
            animate opacity { duration: 160ms; easing: ease-in-out; }

            if !root.is_expanded: Text {
                text: "Dumm";
                color: #f4f4f5;
                font-size: 12px * root.scale;
                overflow: elide;
                horizontal-alignment: center;
            }

            // Baris 1: artwork, judul, artis, progress, waktu.
            if root.is_expanded: HorizontalLayout {
                spacing: 14px * root.scale;
                alignment: start;

                Rectangle {
                    width: 56px * root.scale;
                    height: 56px * root.scale;
                    border-radius: 12px * root.scale;
                    background: #18181b;
                    clip: true;
                    Image { source: root.media-artwork; image-fit: cover; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3px * root.scale;

                    Text {
                        text: root.media-title != "" ? root.media-title : "Dumm Active";
                        color: #fafafa;
                        font-weight: 700;
                        font-size: 15px * root.scale;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                    Text {
                        text: root.media-artist != "" ? root.media-artist : "Media & HUD Hub";
                        color: #9a9aa4;
                        font-size: 12px * root.scale;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                    Rectangle {
                        height: 4px * root.scale;
                        border-radius: 2px;
                        background: #26262c;
                        Rectangle {
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.position-frac));
                            height: parent.height;
                            border-radius: 2px;
                            background: #e8e8ec;
                        }
                    }
                    if root.duration-label != "": Rectangle {
                        height: 12px * root.scale;
                        Text {
                            x: 0px;
                            text: root.position-label;
                            color: #8f8f99;
                            font-size: 10px * root.scale;
                            horizontal-alignment: left;
                        }
                        Text {
                            x: parent.width - 64px * root.scale;
                            width: 64px * root.scale;
                            text: root.duration-label;
                            color: #8f8f99;
                            font-size: 10px * root.scale;
                            horizontal-alignment: right;
                        }
                    }
                }
            }

            // Baris 2: tiga tombol kontrol, sejajar dengan zona kliknya.
            if root.is_expanded: HorizontalLayout {
                alignment: center;
                spacing: root.button-gap;

                Rectangle {
                    width: root.button-size; height: root.button-size;
                    border-radius: 11px * root.scale;
                    background: root.hover-zone == 1 ? #1a1a1f : transparent;
                    Image {
                        width: 20px * root.scale; height: 20px * root.scale;
                        source: @image-url("../assets/icons/skip-back.svg");
                    }
                }
                Rectangle {
                    width: root.button-size; height: root.button-size;
                    border-radius: 11px * root.scale;
                    background: root.hover-zone == 2 ? #1a1a1f : transparent;
                    Image {
                        width: 20px * root.scale; height: 20px * root.scale;
                        source: root.is-playing
                            ? @image-url("../assets/icons/pause.svg")
                            : @image-url("../assets/icons/play.svg");
                    }
                }
                Rectangle {
                    width: root.button-size; height: root.button-size;
                    border-radius: 11px * root.scale;
                    background: root.hover-zone == 3 ? #1a1a1f : transparent;
                    Image {
                        width: 20px * root.scale; height: 20px * root.scale;
                        source: @image-url("../assets/icons/skip-forward.svg");
                    }
                }
            }
        }
    }

    // Zona hover dari posisi kursor: tombol terdekat.
    hover-zone: (root.is_expanded && root.pointer-in)
        ? root.zone(root.pointer-x, pill.width, root.center-offset)
        : 0;

    // Jarak dihitung sebagai float (dibagi 1px) karena Math.abs bekerja pada float.
    pure function zone(mx: length, w: length, off: length) -> int {
        let d0 = Math.abs((mx - (w / 2 - off)) / 1px);
        let d1 = Math.abs((mx - w / 2) / 1px);
        let d2 = Math.abs((mx - (w / 2 + off)) / 1px);
        if (d0 <= d1 && d0 <= d2) { return 1; }
        if (d2 <= d1) { return 3; }
        return 2;
    }

    function dispatch(zone: int) {
        if (zone == 1) { root.previous(); }
        else if (zone == 3) { root.next(); }
        else { root.play-pause(); }
    }

    // HUD volume.
    if root.hud-visible: Rectangle {
        x: pill.x + 12px * root.scale;
        y: pill.y + pill.height - 6px * root.scale;
        width: pill.width - 24px * root.scale;
        height: 4px * root.scale;
        border-radius: 2px;
        background: #26262c;
        Rectangle {
            width: root.volume-muted
                ? parent.width
                : parent.width * Math.max(0.0, Math.min(1.0, root.volume-level));
            height: parent.height;
            border-radius: 2px;
            background: root.volume-muted ? #71717a : #e8e8ec;
        }
    }
    if root.hud-visible: Text {
        x: pill.x + pill.width - 50px * root.scale;
        y: pill.y + pill.height - 17px * root.scale;
        width: 44px * root.scale;
        height: 12px * root.scale;
        text: root.volume-muted ? "Muted" : "\{Math.round(root.volume-level * 100)}%";
        color: #f4f4f5;
        font-size: 10px * root.scale;
        horizontal-alignment: right;
    }
}
