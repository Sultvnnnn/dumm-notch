export component MainWindow inherits Window {
    title: "DummNotchOverlay";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    width: 420px;
    height: 160px;

    in-out property <bool> is_expanded: false;
    // Diisi layanan media; string kosong berarti tidak ada sesi.
    in property <string> media-title;
    in property <string> media-artist;
    in property <bool> is-playing;
    in property <image> media-artwork;
    in property <float> volume-level: 0.0;
    in property <bool> volume-muted: false;
    // V2: false sampai main.rs menyelesaikan pembaruan volume pertama (baseline). Selama
    // false, perubahan volume-level tidak memunculkan HUD sehingga tidak berkedip saat start.
    in property <bool> volume-ready: false;
    in-out property <bool> hud-visible: false;
    callback play-pause();
    callback next();
    callback previous();

    // Satu timer sekali-jalan untuk HUD volume. Saat idle `running == false` (tidak ada timer
    // hidup). Trigger mematikan HUD; karena `running` terikat `hud-visible`, timer ikut mati.
    hud-timer := Timer {
        interval: 1500ms;
        running: root.hud-visible;
        triggered => { root.hud-visible = false; }
    }

    changed volume-level => {
        if (root.volume-ready) { root.hud-visible = true; hud-timer.restart(); }
    }
    changed volume-muted => {
        if (root.volume-ready) { root.hud-visible = true; hud-timer.restart(); }
    }

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;

        width: is_expanded ? 380px : 180px;
        height: is_expanded ? 90px : 32px;
        background: #09090b;
        border-bottom-left-radius: 18px;
        border-bottom-right-radius: 18px;

        animate width { duration: 250ms; easing: ease-out; }
        animate height { duration: 250ms; easing: ease-out; }

        // Satu TouchArea untuk seluruh pill. TouchArea yang bersarang di dalam layout tidak
        // menerima hit-test (terbukti dari pengujian klik: badan pill selalu menang), jadi
        // tombol ditentukan dari posisi pointer di dalam area ini.
        TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                root.is_expanded = self.has-hover;
            }

            clicked => {
                if (root.is_expanded) {
                    // Baris tombol: 28 px di bagian bawah pill, tiga tombol berdampingan
                    // dengan pusat di width/2 - 28, width/2, dan width/2 + 28.
                    if (self.mouse-y >= self.height - 44px && self.mouse-y <= self.height - 16px) {
                        if (self.mouse-x < self.width / 2 - 14px) {
                            root.previous();
                        } else if (self.mouse-x > self.width / 2 + 14px) {
                            root.next();
                        } else {
                            root.play-pause();
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 6px;
            spacing: 0px;
            alignment: center;

            if !root.is_expanded: Text {
                text: !root.is_expanded ? "Dumm"
                    : root.media-title != "" ? root.media-title
                    : "Dumm Active - Media & HUD Hub";
                color: #f4f4f5;
                font-size: root.is_expanded ? 14px : 12px;
                overflow: elide;
                horizontal-alignment: center;
            }

            if root.is_expanded: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 6px;
                    background: #18181b;
                    clip: true;
                    Image { source: root.media-artwork; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.media-title != "" ? root.media-title : "Dumm"; color: #f4f4f5; font-size: 14px; overflow: elide; }
                    Text { text: root.media-artist; color: #f4f4f5; font-size: 12px; overflow: elide; }
                }
            }

            if root.is_expanded: HorizontalLayout {
                alignment: center;
                spacing: 8px;

                // Ikon Phosphor (MIT), bobot fill, 20 px. spacing 8 px membuat jarak
                // antar-pusat ikon tepat 28 px, sama dengan zona klik di TouchArea pill.
                // Ikon hanya tampilan; yang menangkap klik adalah TouchArea di atas.
                Image {
                    width: 20px; height: 20px;
                    source: @image-url("../assets/icons/skip-back.svg");
                }
                Image {
                    width: 20px; height: 20px;
                    source: root.is-playing
                        ? @image-url("../assets/icons/pause.svg")
                        : @image-url("../assets/icons/play.svg");
                }
                Image {
                    width: 20px; height: 20px;
                    source: @image-url("../assets/icons/skip-forward.svg");
                }
            }

        }
    }

    // HUD volume: bar 4 px di bagian bawah pill + angka persen (10 px) di kanan. Anak root
    // (bukan pill) agar bebas diposisikan; koordinat mengikuti geometri pill sehingga tidak
    // mengubah tinggi pill dan tidak menggeser baris ikon. Muncul saat expanded maupun collapsed.
    if root.hud-visible: Rectangle {
        // V3: margin horizontal 12 px (radius 18 px) agar bar tidak menyentuh tepi
        // membulat pill sehingga ujung bawah tidak tampak persegi.
        x: pill.x + 12px;
        y: pill.y + pill.height - 6px;
        width: pill.width - 24px;
        height: 4px;
        border-radius: 2px;
        background: #27272a;
        Rectangle {
            width: root.volume-muted
                ? parent.width
                : parent.width * Math.max(0.0, Math.min(1.0, root.volume-level));
            height: parent.height;
            border-radius: 2px;
            background: root.volume-muted ? #71717a : #f4f4f5;
        }
    }
    if root.hud-visible: Text {
        x: pill.x + pill.width - 50px;
        y: pill.y + pill.height - 16px;
        width: 44px;
        height: 12px;
        text: root.volume-muted ? "Muted" : "\{Math.round(root.volume-level * 100)}%";
        color: #f4f4f5;
        font-size: 10px;
        horizontal-alignment: right;
    }
}
